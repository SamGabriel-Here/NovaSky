{
  "name": "novasky",
  "version": "0.1.0",
  "description": "NovaSky \u2014 a desktop stargazing app for Windows, macOS and Linux.",
  "main": "./out/main/index.js",
  "author": "NovaSky",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "data:build": "node scripts/build-data.mjs",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "electron-builder install-app-deps",
    "pack:mac": "npm run build && electron-builder --mac --config electron-builder.yml --publish never",
    "pack:win": "npm run build && electron-builder --win --config electron-builder.yml --publish never",
    "pack:linux": "npm run build && electron-builder --linux --config electron-builder.yml --publish never",
    "smoke": "electron-vite build && electron scripts/smoke.cjs",
    "capture": "electron-vite build --mode development && electron scripts/capture.cjs",
    "icon": "electron scripts/make-icon.cjs",
    "offline": "electron-vite build && electron scripts/offline-check.cjs"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "better-sqlite3": "^11.5.0",
    "satellite.js": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.13",
    "three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3",
    "zustand": "^5.0.0"
  }
}
